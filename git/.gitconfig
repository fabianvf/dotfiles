[user]
	name = Fabian von Feilitzsch
	email = fabian@fabianism.us
[alias]
	st = status
	co = checkout
	ci = commit
	br = branch
	df = diff
	dfs = diff --staged
	logg = log --graph --decorate --oneline --abbrev-commit --all
	pup = pull upstream
	shorg = push -u origin
	pl = pull
	unstage = reset HEAD --
	mylog = log --first-parent --no-merges
[color]
	ui = auto
[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
[apply]
	whitespace = nowarn
[mergetool]
	keepBackup = false
[difftool]
	prompt = false
[push]
	default = current
[credential]
	helper = cache
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
